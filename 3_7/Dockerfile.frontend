FROM node:16-alpine

EXPOSE 5001

WORKDIR /usr/src/app

COPY ./3_7/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN npm install && npm run build && npm install -g serve && adduser -D appuser && chown -R appuser .

USER appuser

CMD ["serve" ,"-s" ,"-l" ,"5001" ,"build"]
