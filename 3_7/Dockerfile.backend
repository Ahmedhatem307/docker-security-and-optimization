FROM golang:1.16-alpine

WORKDIR /app

COPY ./3_7/example-backend/go.mod ./3_7/example-backend/go.sum ./
COPY ./3_7/example-backend/ .

RUN apk add --no-cache build-base  && go mod download && go build && go test ./... && adduser -D appuser && chown -R appuser .

EXPOSE 8080

ENV PORT=8080
ENV REQUEST_ORIGIN=http://localhost:5001

USER appuser

CMD ["./server"]
