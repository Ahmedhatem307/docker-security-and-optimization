FROM golang:1.16-alpine AS builder

WORKDIR /app

COPY ./3_89/example-backend/go.mod ./3_89/example-backend/go.sum ./
COPY ./3_89/example-backend/ .

RUN apk add --no-cache build-base  && go mod download && go build && go test ./... && adduser -D appuser && chown -R appuser .

FROM scratch

WORKDIR /

COPY --from=builder /app/server /server

EXPOSE 8080

ENV REQUEST_ORIGIN=http://localhost:5001
ENV PORT=8080

USER 10001:10001

CMD ["/server"]
