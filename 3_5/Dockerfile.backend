FROM golang:1.16

WORKDIR /app

COPY ./3_5/example-backend/go.mod ./3_5/example-backend/go.sum ./

RUN go mod download

COPY ./3_5/example-backend/ .

RUN go build

RUN go test ./...

EXPOSE 8080

ENV PORT=8080
ENV REQUEST_ORIGIN=http://localhost:5001

RUN useradd -m appuser

RUN chown -R appuser .

USER appuser

CMD ["./server"]
